{
  "input_file": "outputs/social_20261029_combined/social_data.xlsx",
  "output_dir": "outputs/nlp_20261029_combined_topics20_01",
  "target_topics": 20,
  "cache_dir": ".cache/social_nlp",
  "seed": 42,
  "include_kinds": [
    "comment",
    "reply"
  ],
  "min_words": 2,
  "min_characters": 8,
  "max_segment_characters": 1200,
  "max_unique_sentences": 100000,
  "model": {
    "backend": "sentence-transformers",
    "repo": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "revision": "e8f8c211226b894fcb81acc59f3b34ba3efd5f42",
    "max_tokens": 128,
    "stride": 24,
    "batch_size": 32,
    "threads": 4
  },
  "dbscan": {
    "eps": [
      0.1,
      0.15,
      0.2,
      0.25,
      0.3
    ],
    "min_samples": [
      3,
      5,
      10
    ],
    "neighborhood_batch_size": 256,
    "max_neighbor_edges": 8000000
  },
  "evaluation": {
    "sample_size": 1800,
    "min_coverage": 0.4,
    "max_largest_cluster": 0.5,
    "score_tolerance": 0.005
  },
  "graph": {
    "max_nodes": 180,
    "neighbors": 3,
    "min_similarity": 0.55
  },
  "explanation": {
    "date_basis": "post_date",
    "include_estimated_dates": true,
    "window_months": 3,
    "min_periods": 6,
    "min_monthly_comments": 20,
    "min_topic_comments": 20,
    "min_window_topic_comments": 5,
    "min_roots": 3,
    "dominance_warning_threshold": 0.6,
    "change_threshold_pp": 2.0,
    "slope_threshold_pp": 0.25,
    "kendall_threshold": 0.25,
    "platform_shift_threshold_pp": 15.0,
    "min_term_comments": 5,
    "max_evidence": 3,
    "mmr_lambda": 0.75
  },
  "umap": {
    "n_neighbors": 15,
    "n_components": 10,
    "min_dist": 0.0
  },
  "coherence": {
    "metric": "c_v",
    "topn": 10,
    "window_size": 110,
    "min_score": 0.4
  }
}
