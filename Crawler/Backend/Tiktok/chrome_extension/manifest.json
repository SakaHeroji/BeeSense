{
  "manifest_version": 3,
  "name": "BeeSense TikTok Connector",
  "version": "1.4.0",
  "minimum_chrome_version": "118",
  "description": "Drive one selected TikTok tab through a local BeeSense crawler. Human CAPTCHA validation only.",
  "key": "",
  "permissions": ["debugger", "activeTab", "storage", "sidePanel"],
  "host_permissions": ["https://www.tiktok.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Buka sidebar BeeSense"
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
