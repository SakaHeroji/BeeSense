# syntax=docker/dockerfile:1
# Local crawler image. Chrome runs in a separate Selenium Grid service.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-selenium.txt requirements-crawler.txt /app/
RUN pip install --no-cache-dir -r requirements-selenium.txt \
    && useradd --create-home --uid 10001 beesense \
    && chown beesense:beesense /app
COPY --chown=beesense:beesense social_crawler.py social_crawler_selenium.py social_crawler.json /app/
COPY --chown=beesense:beesense Youtube/crawl_youtube.py Youtube/social_common.py Youtube/contract.json /app/Youtube/
COPY --chown=beesense:beesense Reddit/crawl_reddit_single.py Reddit/contract.json Reddit/rendered_thread_dom.mjs /app/Reddit/
USER beesense
ENTRYPOINT ["python", "social_crawler_selenium.py"]
CMD ["--dry-run"]
