# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /app
RUN useradd --create-home --uid 10001 beesense
COPY requirements/tiktok.txt /app/requirements/tiktok.txt
RUN pip install --no-cache-dir -r requirements/tiktok.txt \
    && python -m playwright install --with-deps chromium
COPY --chown=beesense:beesense Crawler /app/Crawler
COPY --chown=beesense:beesense config/social_crawler.json /app/config/social_crawler.json
RUN mkdir -p /data /app/output /app/outputs /app/.cache/tiktok \
    && chown -R beesense:beesense /data /app/output /app/outputs /app/.cache
USER beesense
# Mount auth.json read-only at runtime. This one-shot CLI exposes no HTTP port.
ENTRYPOINT ["python", "-m", "Crawler.Backend.tiktok_crawler"]
CMD ["--dry-run"]
