# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 10001 beesense
COPY requirements/instaloader.txt /app/requirements/instaloader.txt
RUN pip install --no-cache-dir -r requirements/instaloader.txt
COPY --chown=beesense:beesense Crawler /app/Crawler
COPY --chown=beesense:beesense config /app/config
RUN mkdir -p /data /app/output/instaloader && chown -R beesense:beesense /data /app/output
USER beesense
# Mount local JSON authentication/session and input datasets at runtime.
ENTRYPOINT ["python", "-m", "Crawler.Backend.instaloader_crawler"]
CMD ["--dry-run"]
