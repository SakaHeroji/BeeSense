# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 10001 beesense
COPY requirements/instagram.txt /app/requirements/instagram.txt
RUN pip install --no-cache-dir -r requirements/instagram.txt
COPY --chown=beesense:beesense Crawler /app/Crawler
COPY --chown=beesense:beesense config /app/config
RUN mkdir -p /data /app/output/instagram && chown -R beesense:beesense /data /app/output
USER beesense
# Mount session at runtime; credentials and sessions never enter the build context.
ENTRYPOINT ["python", "-m", "Crawler.Backend.instagram_crawler"]
CMD ["--dry-run"]
