# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libgtk-3-0 libdbus-glib-1-2 libasound2 libx11-xcb1 \
    libxt6 libnss3 libgbm1 fonts-liberation unzip xvfb xauth \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 beesense
COPY requirements /app/requirements
RUN pip install --no-cache-dir -r requirements/crawler.txt
COPY --chown=beesense:beesense Crawler /app/Crawler
COPY --chown=beesense:beesense config /app/config
RUN mkdir /data && chown beesense:beesense /data /app
USER beesense
ENV HOME=/home/beesense
RUN reddrix install
# One-shot worker, no listening service or readiness port.
ENTRYPOINT ["python", "-m", "Crawler.Backend.social_crawler"]
CMD ["--dry-run"]
