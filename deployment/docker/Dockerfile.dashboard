ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BEESENSE_NLP_RUN_DIR=/data/nlp_run \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
WORKDIR /app
COPY requirements.txt /app/
COPY requirements/dashboard.txt /app/requirements/dashboard.txt
RUN pip install --no-cache-dir --no-compile --only-binary=:all: -r requirements.txt \
    && useradd --create-home --uid 10001 beesense \
    && chown -R beesense:beesense /app
COPY --chown=beesense:beesense streamlit_apps.py /app/
COPY --chown=beesense:beesense MachineLearning /app/MachineLearning
COPY --chown=beesense:beesense Dashboard /app/Dashboard
COPY --chown=beesense:beesense config/social_nlp.json /app/config/
COPY --chown=beesense:beesense .streamlit /app/.streamlit
USER beesense
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
CMD ["streamlit", "run", "streamlit_apps.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
