# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 10001 beesense
COPY requirements/twitter.txt /app/requirements/twitter.txt
RUN pip install --no-cache-dir -r requirements/twitter.txt
COPY --chown=beesense:beesense Crawler /app/Crawler
COPY --chown=beesense:beesense config /app/config
RUN mkdir -p /data /app/output/scweet && chown -R beesense:beesense /data /app/output
USER beesense
ENTRYPOINT ["python", "-m", "Crawler.Backend.twitter_crawler"]
CMD ["--dry-run"]
