{
  "input_file": "outputs/social_20261028_01/social_data.xlsx",
  "output_dir": "outputs/nlp_20261028_02",
  "cache_dir": ".cache/social_nlp",
  "seed": 42,
  "include_kinds": ["comment", "reply"],
  "min_words": 2,
  "min_characters": 8,
  "max_segment_characters": 1200,
  "max_unique_sentences": 100000,
  "model": {
    "repo": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "revision": "e8f8c211226b894fcb81acc59f3b34ba3efd5f42",
    "onnx_file": "onnx/model_quint8_avx2.onnx",
    "max_tokens": 128,
    "stride": 24,
    "batch_size": 32,
    "threads": 4
  },
  "umap": {"n_neighbors": 15, "n_components": 10, "min_dist": 0.0},
  "hdbscan": {"min_cluster_sizes": [15, 30, 60], "min_samples": [5, 10]},
  "kmeans": {"cluster_counts": [40, 80, 120], "n_init": 10},
  "tfidf_baseline_clusters": 80,
  "evaluation": {"sample_size": 1800, "min_coverage": 0.4, "max_largest_cluster": 0.5, "score_tolerance": 0.005},
  "graph": {"max_nodes": 180, "neighbors": 3, "min_similarity": 0.55},
  "explanation": {
    "date_basis": "post_date",
    "include_estimated_dates": true,
    "window_months": 3,
    "min_periods": 6,
    "min_monthly_comments": 20,
    "min_topic_comments": 20,
    "min_window_topic_comments": 5,
    "min_roots": 3,
    "dominance_warning_threshold": 0.6,
    "change_threshold_pp": 2.0,
    "slope_threshold_pp": 0.25,
    "kendall_threshold": 0.25,
    "platform_shift_threshold_pp": 15.0,
    "min_term_comments": 5,
    "max_evidence": 3,
    "mmr_lambda": 0.75
  }
}
